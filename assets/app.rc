#pragma code_page(65001)
#include <windows.h>

// Application icon: shown by Explorer, the taskbar and the Start Menu.
IDI_ICON1 ICON "pdfboard.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,5,4,0
PRODUCTVERSION  1,5,4,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "PDFBoard"
            VALUE "FileDescription",  "大屏 PDF 批注"
            VALUE "FileVersion",      "1.5.4.0"
            VALUE "InternalName",     "pdfboard"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "pdfboard.exe"
            VALUE "ProductName",      "大屏 PDF 批注"
            VALUE "ProductVersion",   "1.5.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
